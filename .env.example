# 必需：服务端私有腾讯云 COS，仅授予本应用对象前缀的最小权限。
COS_BUCKET=qintopia-image-1305166808
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=

# 兼容字段：readCosConfig 当前仍要求这两项非空并校验格式。
# COS_DOMAIN 需为 HTTPS 根域名，CDN_AUTH_KEY 至少 16 字符；已有部署保留原值。
# 当前图片由应用的 /api/assets 路由直接返回 COS 字节，不使用 CDN 签名跳转，
# 因此无需为当前图片访问链路启用 CDN 或 Type D 鉴权。
COS_DOMAIN=https://image.qintopia.cn
CDN_AUTH_KEY=

# 必需：至少 32 字符的独立随机密钥；更换后已有图片能力链接将失效。
ASSET_ACCESS_SECRET=

# 可选：应用地址，用于元数据；正式部署设为 https://image.qintopia.cn。
# 中转 Base URL / Token 在页面 API 设置中填写。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 账号版：目标必须在 deploy/database-targets.json 中，运行进程仅持有runtime连接。
IMAGE_DATABASE_TARGET=local
IMAGE_DATABASE_URL=
# 独立认证密钥，至少32字符；不是ASSET_ACCESS_SECRET。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# IMAGE_MIGRATION_DATABASE_URL 仅在受控迁移命令进程中注入，禁止传给应用。

# 模型配置加密密钥：严格32字节随机值的base64编码；独立保管/备份，禁止写入Git。
PROVIDER_CONFIG_KEY=
# 可选：共享生成保护，默认全局2并发、单账号1并发、每账号每分钟6次。
# IMAGE_GENERATION_MAX_CONCURRENT=2
# IMAGE_GENERATION_PER_USER_CONCURRENT=1
# IMAGE_GENERATION_RATE_PER_MINUTE=6
