#!/usr/bin/python3
"""Second validation at the privilege boundary, before the isolated interpreter."""
import os
import re
import sys


def validated(arguments, sudo_user=None):
    if arguments in [['status'], ['maintenance'], ['maintenance', 'dry-run'], ['maintenance', 'apply']]:
        return arguments
    if arguments in [[name] for name in ['bootstrap', 'recover', 'service-maintenance', 'database-status', 'database-backup', 'database-restore', 'database-verify-restore', 'database-bootstrap-admin', 'database-verify-bootstrap-admin']] and sudo_user != 'qintopia-image-deploy':
        return arguments
    if len(arguments) != 5 or arguments[0] not in ['deploy', 'rollback']:
        raise ValueError('restricted release command required')
    operation, version, revision, prefix, checksum = arguments
    if (not re.fullmatch(r'v(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)', version)
            or not re.fullmatch('[0-9a-f]{40}', revision)
            or not re.fullmatch('[0-9a-f]{64}', checksum)
            or prefix != f'qintopia-image/releases/{version}/{revision}/'):
        raise ValueError('invalid release identity')
    return [operation, version, revision, prefix, checksum]


def main():
    try:
        arguments = validated(sys.argv[1:], os.environ.get('SUDO_USER'))
    except ValueError:
        sys.exit('restricted image release command required')
    os.execve('/opt/qintopia-image-release/venv/bin/python3',
              ['python3', '-I', '/opt/qintopia-image-release/entry.py', *arguments],
              {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root', 'LANG': 'C.UTF-8'})


if __name__ == '__main__':
    main()
