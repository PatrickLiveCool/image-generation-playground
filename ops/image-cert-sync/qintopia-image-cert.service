[Unit]
Description=Renew and verify free SSL certificate for image.qintopia.cn CDN
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=qintopia-image-cert
Group=qintopia-image-cert
ExecStart=/usr/bin/python3 /opt/qintopia-image-cert/renew.py --apply
StateDirectory=qintopia-image-cert
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/qintopia-image-cert
